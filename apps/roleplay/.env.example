# Chave da API Anthropic — fica SÓ no servidor (VPS), nunca no navegador
ANTHROPIC_API_KEY=sk-ant-...

# Supabase do DASHBOARD/MazyOS (ref norgsipmgxbakfmkqcnl).
# NÃO usar o projeto do DeskcommCRM (pdtbrtccausjlrzzsiqe) — o app confere o ref do
# JWT no boot e se recusa a subir se a chave for do projeto errado.
SUPABASE_URL=https://norgsipmgxbakfmkqcnl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Código de acesso simples (digitado uma vez no app). Se vazio, app fica aberto.
